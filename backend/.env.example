# AquaFleet - example environment file
#
# Copy this file to `.env` in the same folder and replace the placeholder
# values with your own MySQL settings.
#
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
#
# The real `.env` file is listed in .gitignore and must NEVER be committed.

# ---- MySQL settings ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=aquafleet_db
DB_CONNECT_TIMEOUT=10

# Managed MySQL providers supply a CA certificate. Save it outside Git and set
# this to its absolute path to enable certificate and hostname verification.
DB_SSL_CA=
DB_SSL_VERIFY_CERT=True
DB_SSL_VERIFY_IDENTITY=True

# ---- Flask settings ----
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True

# ---- Session / authentication settings ----
#
# SECRET_KEY signs the Flask session cookie. Anyone who knows it can forge a
# logged-in session, so treat it exactly like a password: keep it out of git
# and use a different value on every machine.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Browser origins allowed to send credentialed (cookie-carrying) requests.
# Comma-separated. Must never be "*" while credentials are enabled.
# 127.0.0.1 and localhost count as different origins, so both are listed.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Send the session cookie over HTTPS only.
# Keep False for local HTTP development; set True for any HTTPS deployment.
SESSION_COOKIE_SECURE=False

# Absolute server-enforced session lifetime and login throttling.
SESSION_LIFETIME_MINUTES=480
LOGIN_RATE_LIMIT=10 per minute

# The default memory backend is for the single-process faculty deployment.
# Use a shared limits-compatible storage URL before running multiple workers.
RATELIMIT_STORAGE_URI=memory://

# Enable only behind a trusted reverse proxy such as Render.
TRUST_PROXY_HEADERS=False
